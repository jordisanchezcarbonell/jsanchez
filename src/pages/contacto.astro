---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contacto | Jordi Sánchez — Full-Stack Developer"
  description="Contacta con Jordi Sánchez para colaborar en desarrollo web, producto, APIs o integraciones."
  canonicalPath="/contacto/"
>
  <header class="page-intro container">
    <p class="eyebrow">Contacto</p>
    <h1>Hablemos de lo que necesitas construir o mejorar.</h1>
    <div class="page-intro__footer">
      <p class="lede">
        Proyecto freelance, colaboración con una agencia u oportunidad profesional. Si hay un problema técnico concreto, podemos empezar por ahí.
      </p>
      <p class="meta-line"><span>Barcelona</span><span>Remoto · presencial</span></p>
    </div>
  </header>

  <section class="contact-section" aria-labelledby="contact-form-title">
    <div class="container contact-grid">
      <div class="contact-copy">
        <p class="eyebrow">Escríbeme</p>
        <h2 id="contact-form-title">Contexto suficiente para darte una respuesta útil.</h2>
        <p>
          No hace falta preparar un briefing perfecto. Con saber qué quieres conseguir, qué existe ahora y dónde está el bloqueo podemos empezar.
        </p>

        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:jordigw@gmail.com">jordigw@gmail.com</a></dd>
          </div>
          <div>
            <dt>Ubicación</dt>
            <dd>Barcelona, España</dd>
          </div>
          <div>
            <dt>Idiomas</dt>
            <dd>Español y catalán</dd>
          </div>
        </dl>
      </div>

      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f7f4ee;
  }

  .contact-grid {
    display: grid;
    gap: clamp(4rem, 10vw, 9rem);
  }

  .contact-copy .eyebrow {
    color: #c77b6d;
  }

  .contact-copy h2 {
    max-width: 10ch;
    font-size: clamp(3rem, 7vw, 6.5rem);
  }

  .contact-copy > p:not(.eyebrow) {
    max-width: 34rem;
    margin-top: 2rem;
    color: #aaa197;
  }

  dl {
    margin: 3rem 0 0;
    border-top: 1px solid #39342d;
  }

  dl div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid #39342d;
  }

  dt {
    color: #aaa197;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
  }

  @media (min-width: 52rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(27rem, 0.8fr);
      align-items: start;
    }
  }
</style>
