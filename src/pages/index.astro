---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
import { services } from '../data/services';

const title = 'Jordi Sánchez — Full-Stack Developer';
const description =
  'Full-Stack Developer en Barcelona especializado en React, Next.js, TypeScript, APIs, integraciones y desarrollo de producto.';

const featuredProjects = projects.filter((project) => project.featured);
const featuredServices = services.slice(0, 4);
const stack = [
  'React',
  'Next.js',
  'TypeScript',
  'React Native',
  'Node.js',
  'NestJS',
  'Strapi',
  'APIs REST',
  'Docker',
  'Testing',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.jordisanchezweb.es/#jordi-sanchez',
      name: 'Jordi Sánchez',
      url: 'https://www.jordisanchezweb.es/',
      email: 'mailto:jordigw@gmail.com',
      jobTitle: 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Barcelona',
        addressCountry: 'ES',
      },
      knowsLanguage: ['es', 'ca'],
      knowsAbout: [
        'React',
        'Next.js',
        'TypeScript',
        'React Native',
        'Node.js',
        'APIs REST',
        'Strapi',
        'Docker',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.jordisanchezweb.es/#servicios',
      name: 'Jordi Sánchez — Desarrollo Full-Stack',
      url: 'https://www.jordisanchezweb.es/servicios/',
      founder: { '@id': 'https://www.jordisanchezweb.es/#jordi-sanchez' },
      areaServed: { '@type': 'Country', name: 'España' },
      serviceType: [
        'Desarrollo React y Next.js',
        'Desarrollo Full-Stack',
        'Integraciones API',
        'React Native',
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-heading">
        <p class="eyebrow">Full-Stack Developer · Barcelona</p>
        <p class="availability"><span aria-hidden="true"></span> Disponible para colaboraciones</p>
      </div>

      <h1 class="hero-title">Producto web que llega a producción y se mantiene estable.</h1>

      <div class="hero-bottom">
        <p class="hero-label" aria-hidden="true">Web · móvil · APIs</p>
        <div class="hero-copy">
          <p class="lede">
            6 años con React, Next.js y TypeScript entre frontend, APIs e integraciones con sistemas como SAP. Colaboro con agencias y equipos de producto.
          </p>
          <div class="hero-actions">
            <a class="button button--accent" href="/contacto/">Trabajar conmigo</a>
            <a class="text-link" href="/proyectos/">Ver proyectos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stack-strip" aria-label="Tecnologías principales">
    <div class="container">
      <p>Stack principal</p>
      <ul>
        {stack.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
  </section>

  <section class="section experience" aria-labelledby="experiencia-title">
    <div class="container">
      <SectionHeading
        id="experiencia-title"
        eyebrow="Experiencia"
        title="Producto digital, desde la interfaz hasta la integración."
        description="Trabajo entre frontend, backend y sistemas externos para llevar funcionalidades reales a producción y mantenerlas estables."
      />

      <ol class="experience-list">
        {experience.map((item, index) => (
          <li>
            <p class="row-index" aria-hidden="true">0{index + 1}</p>
            <div>
              <p class="row-meta">{item.period}</p>
              <h3>{item.company}</h3>
              <p class="row-role">{item.role}</p>
            </div>
            <div>
              <p>{item.summary}</p>
              <ul aria-label={`Tecnologías utilizadas en ${item.company}`}>
                {item.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <a class="text-link section-link" href="/sobre-mi/">Ver experiencia completa</a>
    </div>
  </section>

  <section class="section projects" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeading
        id="projects-title"
        eyebrow="Proyectos seleccionados"
        title="Producto propio y problemas reales de software."
        description="Una selección que combina Primer Down, un proyecto público, con casos profesionales anonimizados que no exponen clientes, endpoints ni métricas privadas."
      />

      <ol class="project-list">
        {featuredProjects.map((project, index) => (
          <li>
            <article>
              <div class="project-heading">
                <p class="row-index">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <p class="row-meta">{project.area}</p>
                  <h3>{project.title}</h3>
                </div>
              </div>
              <p>{project.contribution}</p>
              <ul aria-label={`Tecnologías de ${project.title}`}>
                {project.technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
              </ul>
              {project.url && (
                <a class="text-link project-link" href={project.url} target="_blank" rel="noreferrer">
                  {project.linkLabel ?? 'Ver proyecto'}
                </a>
              )}
            </article>
          </li>
        ))}
      </ol>

      <a class="button" href="/proyectos/">Ver todos los proyectos</a>
    </div>
  </section>

  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeading
        id="services-title"
        eyebrow="Servicios"
        title="Capacidad técnica donde el producto la necesita."
        description="Colaboraciones concretas con empresas, producto y agencias: desde una integración hasta la evolución continuada de una aplicación."
      />

      <ol class="service-list">
        {featuredServices.map((service, index) => (
          <li>
            <p class="row-index">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>

      <a class="text-link section-link" href="/servicios/">Explorar servicios</a>
    </div>
  </section>

  <section class="clubs" aria-labelledby="clubs-title">
    <div class="container clubs-grid">
      <div>
        <p class="eyebrow">Vertical especializada</p>
        <h2 id="clubs-title">Tecnología para clubes y negocios deportivos.</h2>
      </div>
      <div>
        <p>
          Inscripciones, reservas, socios, calendario, patrocinadores, eventos y automatización en una landing específica, separada del posicionamiento principal.
        </p>
        <a class="button button--accent" href="/clubes/">Ver solución para clubes</a>
      </div>
    </div>
  </section>

  <section class="section about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Forma de trabajar</p>
        <h2 id="about-title">Entender el sistema antes de tocarlo.</h2>
      </div>
      <div>
        <p class="lede">
          Me gusta convertir contexto complejo en decisiones técnicas claras. Investigo el flujo completo, trabajo cerca de producto y dejo el código preparado para que el siguiente cambio sea más sencillo.
        </p>
        <a class="text-link" href="/sobre-mi/">Más sobre mí</a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-grid">
      <p class="eyebrow">Siguiente paso</p>
      <h2>¿Construimos o mejoramos algo que ya importa?</h2>
      <div>
        <p>Cuéntame el contexto. Te responderé con preguntas concretas y un siguiente paso realista.</p>
        <a class="button button--accent" href="/contacto/">Trabajar conmigo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
  }

  .hero-inner {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .hero-heading .eyebrow {
    margin-bottom: 0;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    max-width: 17ch;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(2.5rem, 5.6vw, 5.5rem);
    line-height: 1;
  }

  .hero-bottom {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.75rem, 4vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .hero-label,
  .stack-strip p {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-label {
    display: none;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .stack-strip {
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #eee9e0;
  }

  .stack-strip .container {
    display: grid;
    gap: 1rem;
  }

  .stack-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-strip li {
    font-size: 0.76rem;
    font-weight: 650;
  }

  .experience-list,
  .project-list,
  .service-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .experience-list > li {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .row-index,
  .row-meta,
  .row-role {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .row-index,
  .row-role {
    color: var(--accent);
  }

  .experience-list h3,
  .project-list h3 {
    margin-top: 0.65rem;
    font-size: clamp(2.3rem, 5vw, 4rem);
  }

  .row-role {
    margin-top: 0.8rem;
  }

  .experience-list > li > div:last-child > p {
    max-width: 39rem;
    color: var(--muted);
  }

  .experience-list ul,
  .project-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-list ul li,
  .project-list ul li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .section-link {
    margin-top: 2.5rem;
  }

  .projects {
    background: var(--ink);
    color: #f7f4ee;
  }

  .projects :global(.section-heading .eyebrow) {
    color: #c77b6d;
  }

  .projects :global(.section-heading p:last-child) {
    color: #aaa197;
  }

  .project-list {
    border-color: #f7f4ee;
  }

  .project-list > li {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid #39342d;
  }

  .project-list article {
    display: grid;
    gap: 1.75rem;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .project-list article > p {
    max-width: 38rem;
    color: #aaa197;
  }

  .project-list ul li {
    border-color: #514940;
    color: #d7d0c6;
  }

  .project-link {
    width: fit-content;
    color: #f7f4ee;
  }

  .projects > .container > .button {
    margin-top: 2.5rem;
    border-color: #f7f4ee;
    color: #f7f4ee;
  }

  .services {
    background: #eee9e0;
  }

  .service-list > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .service-list h3 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .service-list li > div > p {
    max-width: 38rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .service-list li > span {
    color: var(--accent);
    font-size: 1.1rem;
  }

  .clubs,
  .final-cta {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f7f4ee;
  }

  .clubs .eyebrow,
  .final-cta .eyebrow {
    color: #c77b6d;
  }

  .clubs-grid,
  .about-grid,
  .final-cta-grid {
    display: grid;
    gap: 2.5rem;
  }

  .clubs h2,
  .about h2,
  .final-cta h2 {
    max-width: 11ch;
  }

  .clubs-grid > div:last-child > p,
  .final-cta-grid > div > p {
    max-width: 34rem;
    color: #aaa197;
  }

  .clubs .button,
  .final-cta .button {
    margin-top: 2rem;
  }

  .about-grid > div:last-child .text-link {
    margin-top: 2rem;
  }

  @media (min-width: 52rem) {
    .hero-label {
      display: block;
    }

    .hero-bottom {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 0.65fr);
    }

    .hero-copy {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .hero-actions {
      justify-content: flex-end;
    }

    .stack-strip .container {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: center;
    }

    .experience-list > li {
      grid-template-columns: 3rem minmax(18rem, 0.65fr) minmax(23rem, 1fr);
    }

    .project-list article {
      grid-template-columns: minmax(20rem, 1fr) minmax(20rem, 0.72fr) minmax(12rem, 0.35fr);
      align-items: end;
    }

    .project-list article > ul {
      justify-content: flex-end;
    }

    .clubs-grid,
    .about-grid,
    .final-cta-grid {
      grid-template-columns: minmax(0, 1fr) minmax(23rem, 0.65fr);
      align-items: end;
    }

    .final-cta-grid .eyebrow {
      grid-column: 1 / -1;
    }
  }
</style>
