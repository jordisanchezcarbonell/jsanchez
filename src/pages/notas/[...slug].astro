---
import { getCollection, render } from 'astro:content';
import NotesArticleLayout from '../../layouts/NotesArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.section === 'general');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<NotesArticleLayout post={post}>
  <Content />
</NotesArticleLayout>
