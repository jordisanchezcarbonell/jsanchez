---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
import { getLocale, localePath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const projects = getProjects(locale);

const t = {
  es: {
    title: 'Proyectos | Jordi Sánchez — Full-Stack Developer',
    description:
      'Casos de estudio sobre producto, frontend, APIs, pagos e integraciones desarrollados por Jordi Sánchez.',
    eyebrow: 'Proyectos',
    heading: 'Producto, integraciones y código en producción.',
    lead: 'Un producto propio y casos de estudio anonimizados sobre problemas reales de software. Sin métricas inventadas ni información interna de clientes.',
    count: `${projects.length} proyectos y áreas`,
    meta: 'Web · móvil · APIs',
    casesTitle: 'Casos de estudio',
    problem: 'Problema',
    work: 'Qué hice',
    result: 'Resultado',
    solution: 'Solución',
    contribution: 'Mi contribución',
    context: 'Contexto público',
    technologiesOf: (title: string) => `Tecnologías de ${title}`,
    liveDemo: 'Ver demo en vivo',
    viewProject: 'Ver proyecto',
    ctaEyebrow: 'Tu contexto',
    ctaTitle: '¿Tienes un producto que necesita avanzar?',
    ctaText: 'Podemos hablar de una funcionalidad concreta, una integración o una colaboración continuada.',
    ctaButton: 'Contarme el proyecto',
  },
  en: {
    title: 'Projects | Jordi Sánchez — Full-Stack Developer',
    description:
      'Case studies on product, frontend, APIs, payments and integrations built by Jordi Sánchez.',
    eyebrow: 'Projects',
    heading: 'Product, integrations and code in production.',
    lead: 'An own product and anonymised case studies about real software problems. No invented metrics and no internal client information.',
    count: `${projects.length} projects and areas`,
    meta: 'Web · mobile · APIs',
    casesTitle: 'Case studies',
    problem: 'Problem',
    work: 'What I did',
    result: 'Result',
    solution: 'Solution',
    contribution: 'My contribution',
    context: 'Public context',
    technologiesOf: (title: string) => `Technologies for ${title}`,
    liveDemo: 'View live demo',
    viewProject: 'View project',
    ctaEyebrow: 'Your context',
    ctaTitle: 'Have a product that needs to move forward?',
    ctaText: 'We can talk about a specific feature, an integration or an ongoing collaboration.',
    ctaButton: 'Tell me about the project',
  },
}[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath={localePath('projects', locale)}
>
  <header class="page-intro container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
    <div class="page-intro__footer">
      <p class="lede">{t.lead}</p>
      <p class="meta-line"><span>{t.count}</span><span>{t.meta}</span></p>
    </div>
  </header>

  <section class="case-section" aria-labelledby="case-title">
    <div class="container">
      <h2 id="case-title" class="visually-hidden">{t.casesTitle}</h2>
      <ol class="case-list">
        {projects.map((project, index) => (
          <li>
            <article>
              <header class="case-header">
                <p class="case-number">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <p class="case-area">{project.area}</p>
                  <h2>{project.title}</h2>
                </div>
              </header>

              {project.image && (
                <figure class="case-media">
                  <Image
                    src={project.image}
                    alt={project.imageAlt ?? ''}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 60rem) 52rem, calc(100vw - 2.5rem)"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              )}

              {project.caseStudy ? (
                <div class="case-details">
                  <section>
                    <h3>{t.problem}</h3>
                    <p>{project.caseStudy.problem}</p>
                  </section>
                  <section>
                    <h3>{t.work}</h3>
                    <p>{project.caseStudy.work}</p>
                  </section>
                  <section>
                    <h3>{project.caseStudy.result ? t.result : t.context}</h3>
                    <p>{project.caseStudy.result ?? project.outcome}</p>
                  </section>
                </div>
              ) : (
                <div class="case-details">
                  <section>
                    <h3>{t.problem}</h3>
                    <p>{project.problem}</p>
                  </section>
                  <section>
                    <h3>{t.solution}</h3>
                    <p>{project.solution}</p>
                  </section>
                  <section>
                    <h3>{t.contribution}</h3>
                    <p>{project.contribution}</p>
                  </section>
                  <section>
                    <h3>{t.context}</h3>
                    <p>{project.outcome}</p>
                  </section>
                </div>
              )}

              <ul class="technology-list" aria-label={t.technologiesOf(project.title)}>
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
              {(project.demoUrl || project.url) && (
                <div class="case-links">
                  {project.demoUrl && (
                    <a class="text-link" href={project.demoUrl} target="_blank" rel="noreferrer">
                      {t.liveDemo}
                    </a>
                  )}
                  {project.url && (
                    <a class="text-link" href={project.url} target="_blank" rel="noreferrer">
                      {project.linkLabel ?? t.viewProject}
                    </a>
                  )}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="project-cta">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">{t.ctaEyebrow}</p>
        <h2>{t.ctaTitle}</h2>
      </div>
      <div>
        <p>{t.ctaText}</p>
        <a class="button button--accent" href={localePath('contact', locale)}>{t.ctaButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-section {
    padding-bottom: var(--section-space);
    border-top: 1px solid var(--line);
  }

  .case-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-list > li {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }

  .case-header {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .case-number,
  .case-area,
  .case-details h3 {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .case-number,
  .case-area {
    color: var(--accent);
  }

  .case-header h2 {
    max-width: 13ch;
    margin-top: 0.8rem;
    font-size: clamp(2.7rem, 6vw, 5.5rem);
  }

  .case-details {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-left: 4.25rem;
  }

  .case-details section {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .case-details section p {
    max-width: 37rem;
    margin-top: 0.8rem;
    color: var(--muted);
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 2.5rem 0 0;
    padding: 0 0 0 4.25rem;
    list-style: none;
  }

  .technology-list li {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .case-media {
    max-width: 52rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0 4.25rem;
    border: 1px solid var(--line);
  }

  .case-media img {
    width: 100%;
    height: auto;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem 2rem;
    margin: 1.5rem 0 0 4.25rem;
  }

  .project-cta {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f7f4ee;
  }

  .project-cta .eyebrow {
    color: #c77b6d;
  }

  .cta-grid {
    display: grid;
    gap: 2.5rem;
  }

  .cta-grid h2 {
    max-width: 10ch;
  }

  .cta-grid > div:last-child > p {
    max-width: 32rem;
    color: #aaa197;
  }

  .cta-grid .button {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .case-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-details:has(> section:nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cta-grid {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.65fr);
      align-items: end;
    }
  }

  @media (max-width: 36rem) {
    .case-details {
      padding-left: 0;
    }

    .technology-list {
      padding-left: 0;
    }

    .case-media,
    .case-links {
      margin-left: 0;
    }
  }
</style>
