---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
import { getLocale, localePath, projectPath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const projects = getProjects(locale);

const t = {
  es: {
    title: 'Proyectos | Jordi Sánchez — Full-Stack Developer',
    description:
      'Proyectos propios de Jordi Sánchez: producto, frontend, APIs y datos.',
    eyebrow: 'Proyectos',
    heading: 'Producto propio y proyectos públicos.',
    lead: 'Proyectos que he construido por mi cuenta. Cada uno tiene su ficha, sin métricas inventadas.',
    count: `${projects.length} proyectos`,
    meta: 'Web · móvil · APIs',
    casesTitle: 'Proyectos',
    problem: 'Problema',
    readCase: 'Ver la ficha',
    technologiesOf: (title: string) => `Tecnologías de ${title}`,
    liveDemo: 'Ver demo en vivo',
    viewProject: 'Ver proyecto',
    ctaEyebrow: 'Siguiente paso',
    ctaTitle: '¿Hablamos?',
    ctaButton: 'Contactar',
  },
  ca: {
    title: 'Projectes | Jordi Sánchez — Full-Stack Developer',
    description:
      'Projectes propis de Jordi Sánchez: producte, frontend, APIs i dades.',
    eyebrow: 'Projectes',
    heading: 'Producte propi i projectes públics.',
    lead: 'Projectes que he construït pel meu compte. Cadascun té la seva fitxa, sense mètriques inventades.',
    count: `${projects.length} projectes`,
    meta: 'Web · mòbil · APIs',
    casesTitle: 'Projectes',
    problem: 'Problema',
    readCase: 'Veure la fitxa',
    technologiesOf: (title: string) => `Tecnologies: ${title}`,
    liveDemo: 'Veure la demo en viu',
    viewProject: 'Veure el projecte',
    ctaEyebrow: 'Pas següent',
    ctaTitle: 'Parlem?',
    ctaButton: 'Contactar',
  },
  en: {
    title: 'Projects | Jordi Sánchez — Full-Stack Developer',
    description:
      'Jordi Sánchez’s own projects: product, frontend, APIs and data.',
    eyebrow: 'Projects',
    heading: 'Own product and public projects.',
    lead: 'Projects I have built on my own. Each one has its own page, with no invented metrics.',
    count: `${projects.length} projects`,
    meta: 'Web · mobile · APIs',
    casesTitle: 'Projects',
    problem: 'Problem',
    readCase: 'View the project page',
    technologiesOf: (title: string) => `Technologies for ${title}`,
    liveDemo: 'View live demo',
    viewProject: 'View project',
    ctaEyebrow: 'Next step',
    ctaTitle: 'Shall we talk?',
    ctaButton: 'Contact',
  },
}[locale];

// Only personal projects are published, so there is a single list.
const groups = [{ items: projects }];
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath={localePath('projects', locale)}
>
  <header class="page-intro container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
    <div class="page-intro__footer">
      <p class="lede">{t.lead}</p>
      <p class="meta-line"><span>{t.count}</span><span>{t.meta}</span></p>
    </div>
  </header>

  <section class="case-section" aria-labelledby="case-title">
    <div class="container">
      <h2 id="case-title" class="visually-hidden">{t.casesTitle}</h2>
      {groups.map((group) => (
      <>
      <ol class="case-list">
        {group.items.map((project, index) => (
          <li>
            <article>
              <header class="case-header">
                <p class="case-number">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <p class="case-area">{project.area}</p>
                  <h2>
                    <a class="case-title-link" href={projectPath(project.slug, locale)}>{project.title}</a>
                  </h2>
                </div>
              </header>

              {project.image && (
                <figure class="case-media">
                  <Image
                    src={project.image}
                    alt={project.imageAlt ?? ''}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 60rem) 52rem, calc(100vw - 2.5rem)"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              )}

              <div class="case-details">
                <section>
                  <h3>{t.problem}</h3>
                  <p>{project.caseStudy?.problem ?? project.problem}</p>
                </section>
              </div>

              <ul class="technology-list" aria-label={t.technologiesOf(project.title)}>
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
              <div class="case-links">
                <a class="text-link case-entry" href={projectPath(project.slug, locale)}>
                  {t.readCase}
                </a>
                {project.demoUrl && (
                  <a class="text-link" href={project.demoUrl} target="_blank" rel="noreferrer">
                    {t.liveDemo}
                  </a>
                )}
                {project.url && (
                  <a class="text-link" href={project.url} target="_blank" rel="noreferrer">
                    {project.linkLabel ?? t.viewProject}
                  </a>
                )}
              </div>
            </article>
          </li>
        ))}
      </ol>
      </>
      ))}
    </div>
  </section>

  <section class="project-cta">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">{t.ctaEyebrow}</p>
        <h2>{t.ctaTitle}</h2>
      </div>
      <div>
        <a class="button button--accent" href={localePath('contact', locale)}>{t.ctaButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-section {
    padding-bottom: var(--section-space);
    border-top: 1px solid var(--line);
  }

  .case-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-list > li {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .case-header {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .case-number,
  .case-area,
  .case-details h3 {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-header h2 {
    max-width: 16ch;
    margin-top: 0.8rem;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
  }

  .case-title-link {
    text-decoration: none;
  }

  .case-title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.08em;
  }

  /* The case page is the primary destination; demo and repository links stay secondary. */
  .case-entry {
    color: var(--accent);
  }

  .case-details {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-left: 4.25rem;
  }

  .case-details section {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .case-details section p {
    max-width: 37rem;
    margin-top: 0.8rem;
    color: var(--muted);
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 2.5rem 0 0;
    padding: 0 0 0 4.25rem;
    list-style: none;
  }

  .technology-list li {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .case-media {
    max-width: 52rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0 4.25rem;
    border: 1px solid var(--line);
  }

  .case-media img {
    width: 100%;
    height: auto;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem 2rem;
    margin: 1.5rem 0 0 4.25rem;
  }

  .project-cta {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f4f5f3;
  }

  .project-cta .eyebrow {
    color: #9db8f5;
  }

  .cta-grid {
    display: grid;
    gap: 2.5rem;
  }

  .cta-grid h2 {
    max-width: 10ch;
  }

  .cta-grid > div:last-child > p {
    max-width: 32rem;
    color: #93a0ab;
  }

  .cta-grid .button {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .case-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-details:has(> section:nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cta-grid {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.65fr);
      align-items: end;
    }
  }

  @media (max-width: 36rem) {
    .case-details {
      padding-left: 0;
    }

    .technology-list {
      padding-left: 0;
    }

    .case-media,
    .case-links {
      margin-left: 0;
    }
  }

  /* Wide screens: title on the left, problem, stack and links on the right. */
  @media (min-width: 60rem) {
    .case-list article {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .case-header {
      grid-row: 1 / span 4;
    }

    .case-list article > :not(.case-header) {
      grid-column: 2;
    }

    .case-details {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
      padding-left: 0;
    }

    .technology-list {
      margin-top: 1.5rem;
      padding-left: 0;
    }

    .case-media {
      margin: 0 0 1.75rem;
    }

    .case-links {
      margin-left: 0;
    }
  }
</style>
