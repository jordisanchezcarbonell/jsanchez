---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getExperience, yearsOfExperience } from '../data/experience';
import { getProjects } from '../data/projects';
import { getServices } from '../data/services';
import { socialLinks } from '../data/social';
import { getLocale, localePath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const years = yearsOfExperience();
const path = (route: Parameters<typeof localePath>[0]) => localePath(route, locale);

const t = {
  es: {
    title: 'Jordi Sánchez — Full-Stack Developer',
    description:
      'Full-Stack Developer en Barcelona especializado en React, Next.js, TypeScript, APIs, integraciones y desarrollo de producto.',
    availability: 'Disponible para colaboraciones',
    heroTitle: 'Producto web que llega a producción y se mantiene estable.',
    heroLabel: 'Web · móvil · APIs',
    heroLead: `${years} años con React, Next.js y TypeScript entre frontend, APIs e integraciones con sistemas como SAP. Colaboro con agencias y equipos de producto.`,
    workWithMe: 'Trabajar conmigo',
    seeProjects: 'Ver proyectos',
    stackLabel: 'Tecnologías principales',
    stackTitle: 'Stack principal',
    restApis: 'APIs REST',
    experienceEyebrow: 'Experiencia',
    experienceTitle: 'Producto digital, desde la interfaz hasta la integración.',
    experienceDescription:
      'Trabajo entre frontend, backend y sistemas externos para llevar funcionalidades reales a producción y mantenerlas estables.',
    technologiesAt: (company: string) => `Tecnologías utilizadas en ${company}`,
    fullExperience: 'Ver experiencia completa',
    projectsEyebrow: 'Proyectos seleccionados',
    projectsTitle: 'Producto propio y problemas reales de software.',
    projectsDescription:
      'Una selección que combina Primer Down, un proyecto público, con casos profesionales anonimizados que no exponen clientes, endpoints ni métricas privadas.',
    problem: 'Problema',
    work: 'Qué hice',
    result: 'Resultado',
    technologiesOf: (title: string) => `Tecnologías de ${title}`,
    liveDemo: 'Ver demo en vivo',
    viewProject: 'Ver proyecto',
    allProjects: 'Ver todos los proyectos',
    servicesEyebrow: 'Servicios',
    servicesTitle: 'Capacidad técnica donde el producto la necesita.',
    servicesDescription:
      'Colaboraciones concretas con empresas, producto y agencias: desde una integración hasta la evolución continuada de una aplicación.',
    exploreServices: 'Explorar servicios',
    aboutEyebrow: 'Forma de trabajar',
    aboutTitle: 'Entender el sistema antes de tocarlo.',
    aboutLead:
      'Me gusta convertir contexto complejo en decisiones técnicas claras. Investigo el flujo completo, trabajo cerca de producto y dejo el código preparado para que el siguiente cambio sea más sencillo.',
    moreAboutMe: 'Más sobre mí',
    nextStep: 'Siguiente paso',
    ctaTitle: '¿Construimos o mejoramos algo que ya importa?',
    ctaText: 'Cuéntame el contexto. Te responderé con preguntas concretas y un siguiente paso realista.',
    serviceName: 'Jordi Sánchez — Desarrollo Full-Stack',
    country: 'España',
  },
  en: {
    title: 'Jordi Sánchez — Full-Stack Developer',
    description:
      'Barcelona-based Full-Stack Developer specialising in React, Next.js, TypeScript, APIs, integrations and product development.',
    availability: 'Available for new projects',
    heroTitle: 'Web products that reach production and stay stable.',
    heroLabel: 'Web · mobile · APIs',
    heroLead: `${years} years with React, Next.js and TypeScript across frontend, APIs and integrations with systems such as SAP. I partner with agencies and product teams.`,
    workWithMe: 'Work with me',
    seeProjects: 'See projects',
    stackLabel: 'Core technologies',
    stackTitle: 'Core stack',
    restApis: 'REST APIs',
    experienceEyebrow: 'Experience',
    experienceTitle: 'Digital product, from the interface to the integration.',
    experienceDescription:
      'I work across frontend, backend and external systems to get real features into production and keep them stable.',
    technologiesAt: (company: string) => `Technologies used at ${company}`,
    fullExperience: 'See full experience',
    projectsEyebrow: 'Selected work',
    projectsTitle: 'An own product and real software problems.',
    projectsDescription:
      'A selection that pairs Primer Down, a public project, with anonymised professional cases that expose no clients, endpoints or private metrics.',
    problem: 'Problem',
    work: 'What I did',
    result: 'Result',
    technologiesOf: (title: string) => `Technologies for ${title}`,
    liveDemo: 'View live demo',
    viewProject: 'View project',
    allProjects: 'See all projects',
    servicesEyebrow: 'Services',
    servicesTitle: 'Technical capacity where the product needs it.',
    servicesDescription:
      'Focused engagements with companies, product teams and agencies: from a single integration to the ongoing evolution of an application.',
    exploreServices: 'Explore services',
    aboutEyebrow: 'How I work',
    aboutTitle: 'Understand the system before changing it.',
    aboutLead:
      'I like turning complex context into clear technical decisions. I look at the whole flow, work close to product and leave the code ready so the next change is easier.',
    moreAboutMe: 'More about me',
    nextStep: 'Next step',
    ctaTitle: 'Shall we build or improve something that already matters?',
    ctaText: 'Tell me the context. I will reply with specific questions and a realistic next step.',
    serviceName: 'Jordi Sánchez — Full-Stack Development',
    country: 'Spain',
  },
}[locale];

const experience = getExperience(locale);
const featuredProjects = getProjects(locale).filter((project) => project.featured);
const services = getServices(locale);
const featuredServices = services.slice(0, 4);
const stack = [
  'React',
  'Next.js',
  'TypeScript',
  'React Native',
  'Node.js',
  'NestJS',
  'Strapi',
  t.restApis,
  'Docker',
  'Testing',
];

const site = 'https://www.jordisanchezweb.es';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#jordi-sanchez`,
      name: 'Jordi Sánchez',
      url: `${site}/`,
      email: 'mailto:jordigw@gmail.com',
      jobTitle: 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Barcelona',
        addressCountry: 'ES',
      },
      sameAs: socialLinks.map((link) => link.url),
      // TODO(Jordi): añadir 'en' si quieres declarar inglés como idioma de trabajo.
      knowsLanguage: ['es', 'ca'],
      knowsAbout: [
        'React',
        'Next.js',
        'TypeScript',
        'React Native',
        'Node.js',
        t.restApis,
        'Strapi',
        'Docker',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#servicios`,
      name: t.serviceName,
      url: `${site}${path('services')}`,
      inLanguage: locale,
      founder: { '@id': `${site}/#jordi-sanchez` },
      areaServed: { '@type': 'Country', name: t.country },
      serviceType: [services[0].title, services[1].title, services[2].title, services[5].title],
    },
  ],
};
---

<BaseLayout title={t.title} description={t.description} canonicalPath={path('home')} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-heading">
        <p class="eyebrow">Full-Stack Developer · Barcelona</p>
        <p class="availability"><span aria-hidden="true"></span> {t.availability}</p>
      </div>

      <h1 class="hero-title">{t.heroTitle}</h1>

      <div class="hero-bottom">
        <p class="hero-label" aria-hidden="true">{t.heroLabel}</p>
        <div class="hero-copy">
          <p class="lede">{t.heroLead}</p>
          <div class="hero-actions">
            <a class="button button--accent" href={path('contact')}>{t.workWithMe}</a>
            <a class="text-link" href={path('projects')}>{t.seeProjects}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stack-strip" aria-label={t.stackLabel}>
    <div class="container">
      <p>{t.stackTitle}</p>
      <ul>
        {stack.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
  </section>

  <section class="section experience" aria-labelledby="experiencia-title">
    <div class="container">
      <SectionHeading
        id="experiencia-title"
        eyebrow={t.experienceEyebrow}
        title={t.experienceTitle}
        description={t.experienceDescription}
      />

      <ol class="experience-list">
        {experience.map((item, index) => (
          <li>
            <p class="row-index" aria-hidden="true">0{index + 1}</p>
            <div>
              <p class="row-meta">{item.period}</p>
              <h3>{item.company}</h3>
              <p class="row-role">{item.role}</p>
            </div>
            <div>
              <p>{item.summary}</p>
              <ul aria-label={t.technologiesAt(item.company)}>
                {item.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <a class="text-link section-link" href={path('about')}>{t.fullExperience}</a>
    </div>
  </section>

  <section class="section projects" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeading
        id="projects-title"
        eyebrow={t.projectsEyebrow}
        title={t.projectsTitle}
        description={t.projectsDescription}
      />

      <ol class="project-list">
        {featuredProjects.map((project, index) => (
          <li>
            <article>
              <div class="project-heading">
                <p class="row-index">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <p class="row-meta">{project.area}</p>
                  <h3>{project.title}</h3>
                </div>
              </div>
              {project.caseStudy ? (
                <dl class="case-summary">
                  <div>
                    <dt>{t.problem}</dt>
                    <dd>{project.caseStudy.problem}</dd>
                  </div>
                  <div>
                    <dt>{t.work}</dt>
                    <dd>{project.caseStudy.work}</dd>
                  </div>
                  {project.caseStudy.result && (
                    <div>
                      <dt>{t.result}</dt>
                      <dd>{project.caseStudy.result}</dd>
                    </div>
                  )}
                </dl>
              ) : (
                <p>{project.contribution}</p>
              )}
              <ul aria-label={t.technologiesOf(project.title)}>
                {project.technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
              </ul>
              {(project.demoUrl || project.url) && (
                <div class="project-links">
                  {project.demoUrl && (
                    <a class="text-link project-link" href={project.demoUrl} target="_blank" rel="noreferrer">
                      {t.liveDemo}
                    </a>
                  )}
                  {project.url && (
                    <a class="text-link project-link" href={project.url} target="_blank" rel="noreferrer">
                      {project.linkLabel ?? t.viewProject}
                    </a>
                  )}
                </div>
              )}
              {project.image && (
                <figure class="project-media">
                  <Image
                    src={project.image}
                    alt={project.imageAlt ?? ''}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 52rem) 50vw, calc(100vw - 2.5rem)"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
            </article>
          </li>
        ))}
      </ol>

      <a class="button" href={path('projects')}>{t.allProjects}</a>
    </div>
  </section>

  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeading
        id="services-title"
        eyebrow={t.servicesEyebrow}
        title={t.servicesTitle}
        description={t.servicesDescription}
      />

      <ol class="service-list">
        {featuredServices.map((service, index) => (
          <li>
            <p class="row-index">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3><a class="service-link" href={`${path('services')}#${service.slug}`}>{service.title}</a></h3>
              <p>{service.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>

      <a class="text-link section-link" href={path('services')}>{t.exploreServices}</a>
    </div>
  </section>

  {locale === 'es' && (
    <section class="clubs" aria-labelledby="clubs-title">
      <div class="container clubs-grid">
        <div>
          <p class="eyebrow">Vertical especializada</p>
          <h2 id="clubs-title">Tecnología para clubes y negocios deportivos.</h2>
        </div>
        <div>
          <p>
            Inscripciones, reservas, socios, calendario, patrocinadores, eventos y automatización en una landing específica, separada del posicionamiento principal.
          </p>
          <a class="button button--accent" href="/clubes/">Ver solución para clubes</a>
        </div>
      </div>
    </section>
  )}

  <section class="section about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2 id="about-title">{t.aboutTitle}</h2>
      </div>
      <div>
        <p class="lede">{t.aboutLead}</p>
        <a class="text-link" href={path('about')}>{t.moreAboutMe}</a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-grid">
      <p class="eyebrow">{t.nextStep}</p>
      <h2>{t.ctaTitle}</h2>
      <div>
        <p>{t.ctaText}</p>
        <a class="button button--accent" href={path('contact')}>{t.workWithMe}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
  }

  .hero-inner {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .hero-heading .eyebrow {
    margin-bottom: 0;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    max-width: 17ch;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(2.5rem, 5.6vw, 5.5rem);
    line-height: 1;
  }

  .hero-bottom {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.75rem, 4vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .hero-label,
  .stack-strip p {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-label {
    display: none;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .stack-strip {
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #eee9e0;
  }

  .stack-strip .container {
    display: grid;
    gap: 1rem;
  }

  .stack-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-strip li {
    font-size: 0.76rem;
    font-weight: 650;
  }

  .experience-list,
  .project-list,
  .service-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .experience-list > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--line);
  }

  .experience-list > li > div:last-child {
    grid-column: 1 / -1;
  }

  .row-index,
  .row-meta,
  .row-role {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .row-index,
  .row-role {
    color: var(--accent);
  }

  .experience-list h3,
  .project-list h3 {
    margin-top: 0.65rem;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
  }

  .row-role {
    margin-top: 0.8rem;
  }

  .experience-list > li > div:last-child > p {
    max-width: 39rem;
    color: var(--muted);
  }

  .experience-list ul,
  .project-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-list ul li,
  .project-list ul li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .section-link {
    margin-top: 2rem;
  }

  .projects {
    background: var(--ink);
    color: #f7f4ee;
  }

  .projects :global(.section-heading .eyebrow) {
    color: #c77b6d;
  }

  .projects :global(.section-heading p:last-child) {
    color: #aaa197;
  }

  /* Muted and accent tokens are tuned for paper; lift them on the dark block (WCAG AA). */
  .projects .row-index {
    color: #c77b6d;
  }

  .projects .row-meta {
    color: #aaa197;
  }

  .project-list {
    border-color: #f7f4ee;
  }

  .project-list > li {
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-bottom: 1px solid #39342d;
  }

  .project-list article {
    display: grid;
    gap: 1.75rem;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .project-list article > p {
    max-width: 38rem;
    color: #aaa197;
  }

  .case-summary {
    display: grid;
    gap: 0.9rem;
    max-width: 38rem;
    margin: 0;
  }

  .case-summary dt {
    color: #d7d0c6;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-summary dd {
    margin: 0.2rem 0 0;
    color: #aaa197;
  }

  .project-list ul li {
    border-color: #514940;
    color: #d7d0c6;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem 2rem;
  }

  .project-link {
    width: fit-content;
    color: #f7f4ee;
  }

  .project-media {
    margin: 0;
    border: 1px solid #39342d;
  }

  .project-media img {
    width: 100%;
    height: auto;
  }

  .projects > .container > .button {
    margin-top: 2.5rem;
    border-color: #f7f4ee;
    color: #f7f4ee;
  }

  .services {
    background: #eee9e0;
  }

  .service-list > li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding-block: clamp(1.4rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 180ms ease;
  }

  /* The heading link stretches over the whole card so the entire row is clickable. */
  .service-link {
    text-decoration: none;
  }

  .service-link::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .service-link:focus-visible {
    outline: none;
  }

  .service-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .service-list > li:hover {
    background: #e6e0d5;
  }

  .service-list > li:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .service-list h3 {
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
  }

  .service-list li > div > p {
    max-width: 38rem;
    margin-top: 0.6rem;
    color: var(--muted);
  }

  .service-list li > span {
    color: var(--accent);
    font-size: 1.1rem;
    transition: transform 180ms ease;
  }

  .service-list > li:hover > span,
  .service-list > li:focus-within > span {
    transform: translate(0.2rem, -0.2rem);
  }

  .clubs,
  .final-cta {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f7f4ee;
  }

  .clubs .eyebrow,
  .final-cta .eyebrow {
    color: #c77b6d;
  }

  .clubs-grid,
  .about-grid,
  .final-cta-grid {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  .clubs h2,
  .about h2,
  .final-cta h2 {
    max-width: 18ch;
  }

  .clubs-grid > div:last-child > p,
  .final-cta-grid > div > p {
    max-width: 34rem;
    color: #aaa197;
  }

  .clubs .button,
  .final-cta .button {
    margin-top: 1.5rem;
  }

  .about-grid > div:last-child .text-link {
    margin-top: 1.5rem;
  }

  @media (min-width: 72rem) {
    .hero-copy {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .hero-actions {
      justify-content: flex-end;
    }
  }

  @media (min-width: 52rem) {
    .hero-label {
      display: block;
    }

    .hero-bottom {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 0.65fr);
    }


    .stack-strip .container {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: center;
    }

    .experience-list > li {
      grid-template-columns: 3rem minmax(18rem, 0.65fr) minmax(23rem, 1fr);
      gap: 1.5rem;
    }

    .experience-list > li > div:last-child {
      grid-column: auto;
    }

    .service-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .project-list article {
      grid-template-columns: minmax(20rem, 1fr) minmax(20rem, 0.72fr) minmax(12rem, 0.35fr);
      align-items: end;
    }

    .project-list article > ul {
      justify-content: flex-end;
    }

    .project-links {
      align-self: start;
    }

    .project-media {
      grid-column: 2 / -1;
    }

    .project-list article:has(.case-summary) {
      align-items: start;
    }

    .case-summary {
