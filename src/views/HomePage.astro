---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseDiagram from '../components/CaseDiagram.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getExperience, yearsOfExperience } from '../data/experience';
import { getProjects } from '../data/projects';
import { getServices } from '../data/services';
import { socialLinks } from '../data/social';
import { getLocale, localePath, projectPath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const years = yearsOfExperience();
const path = (route: Parameters<typeof localePath>[0]) => localePath(route, locale);

const t = {
  es: {
    title: 'Jordi Sánchez — Full-Stack Developer',
    description:
      'Full-Stack Developer en Barcelona especializado en React, Next.js, TypeScript, APIs, integraciones y desarrollo de producto.',
    availability: 'Barcelona · Abierto a remoto',
    heroTitle: 'Full-Stack para la parte del producto que no puede fallar ni filtrarse.',
    heroLabel: 'Web · móvil · APIs',
    heroLead: `Pagos 3DS, integraciones con SAP y sistemas con IA, construidos pensando en cómo se atacan. ${years} años en React, Next.js y NestJS.`,
    seeCases: 'Ver casos',
    contact: 'Contactar',
    restApis: 'APIs REST',
    experienceEyebrow: 'Experiencia',
    experienceTitle: 'Producto digital, desde la interfaz hasta la integración.',
    experienceDescription:
      'Trabajo entre frontend, backend y sistemas externos para llevar funcionalidades reales a producción y mantenerlas estables.',
    technologiesAt: (company: string) => `Tecnologías utilizadas en ${company}`,
    fullExperience: 'Ver experiencia completa',
    projectsEyebrow: 'Proyectos seleccionados',
    projectsTitle: 'Producto propio y problemas reales de software.',
    projectsDescription:
      'Una selección que combina Primer Down, un proyecto público, con casos profesionales anonimizados que no exponen clientes, endpoints ni métricas privadas.',
    problem: 'Problema',
    work: 'Qué hice',
    result: 'Resultado',
    technologiesOf: (title: string) => `Tecnologías de ${title}`,
    liveDemo: 'Ver demo en vivo',
    viewProject: 'Ver proyecto',
    readCase: 'Leer el caso',
    allProjects: 'Ver todos los proyectos',
    aboutEyebrow: 'Forma de trabajar',
    aboutTitle: 'Entender el sistema antes de tocarlo.',
    aboutLead:
      'Me gusta convertir contexto complejo en decisiones técnicas claras. Investigo el flujo completo, trabajo cerca de producto y dejo el código preparado para que el siguiente cambio sea más sencillo.',
    moreAboutMe: 'Más sobre mí',
    nextStep: 'Siguiente paso',
    ctaTitle: '¿Hablamos?',
    serviceName: 'Jordi Sánchez — Desarrollo Full-Stack',
    country: 'España',
  },
  ca: {
    title: 'Jordi Sánchez — Full-Stack Developer',
    description:
      'Full-Stack Developer a Barcelona especialitzat en React, Next.js, TypeScript, APIs, integracions i desenvolupament de producte.',
    availability: 'Barcelona · Obert a remot',
    heroTitle: 'Full-Stack per a la part del producte que no pot fallar ni filtrar-se.',
    heroLabel: 'Web · mòbil · APIs',
    heroLead: `Pagaments 3DS, integracions amb SAP i sistemes amb IA, construïts pensant en com s’ataquen. ${years} anys en React, Next.js i NestJS.`,
    seeCases: 'Veure casos',
    contact: 'Contactar',
    restApis: 'APIs REST',
    experienceEyebrow: 'Experiència',
    experienceTitle: 'Producte digital, des de la interfície fins a la integració.',
    experienceDescription:
      'Treballo entre frontend, backend i sistemes externs per portar funcionalitats reals a producció i mantenir-les estables.',
    technologiesAt: (company: string) => `Tecnologies utilitzades a ${company}`,
    fullExperience: 'Veure l’experiència completa',
    projectsEyebrow: 'Projectes seleccionats',
    projectsTitle: 'Producte propi i problemes reals de programari.',
    projectsDescription:
      'Una selecció que combina Primer Down, un projecte públic, amb casos professionals anonimitzats que no exposen clients, endpoints ni mètriques privades.',
    problem: 'Problema',
    work: 'Què vaig fer',
    result: 'Resultat',
    technologiesOf: (title: string) => `Tecnologies: ${title}`,
    liveDemo: 'Veure la demo en viu',
    viewProject: 'Veure el projecte',
    readCase: 'Llegir el cas',
    allProjects: 'Veure tots els projectes',
    aboutEyebrow: 'Manera de treballar',
    aboutTitle: 'Entendre el sistema abans de tocar-lo.',
    aboutLead:
      'M’agrada convertir context complex en decisions tècniques clares. Investigo el flux complet, treballo a prop de producte i deixo el codi preparat perquè el canvi següent sigui més senzill.',
    moreAboutMe: 'Més sobre mi',
    nextStep: 'Pas següent',
    ctaTitle: 'Parlem?',
    serviceName: 'Jordi Sánchez — Desenvolupament Full-Stack',
    country: 'Espanya',
  },
  en: {
    title: 'Jordi Sánchez — Full-Stack Developer',
    description:
      'Barcelona-based Full-Stack Developer specialising in React, Next.js, TypeScript, APIs, integrations and product development.',
    availability: 'Barcelona · Open to remote',
    heroTitle: 'Full-stack for the part of the product that cannot fail or leak.',
    heroLabel: 'Web · mobile · APIs',
    heroLead: `3DS payments, SAP integrations and AI systems, built with how they get attacked in mind. ${years} years in React, Next.js and NestJS.`,
    seeCases: 'See cases',
    contact: 'Contact',
    restApis: 'REST APIs',
    experienceEyebrow: 'Experience',
    experienceTitle: 'Digital product, from the interface to the integration.',
    experienceDescription:
      'I work across frontend, backend and external systems to get real features into production and keep them stable.',
    technologiesAt: (company: string) => `Technologies used at ${company}`,
    fullExperience: 'See full experience',
    projectsEyebrow: 'Selected work',
    projectsTitle: 'An own product and real software problems.',
    projectsDescription:
      'A selection that pairs Primer Down, a public project, with anonymised professional cases that expose no clients, endpoints or private metrics.',
    problem: 'Problem',
    work: 'What I did',
    result: 'Result',
    technologiesOf: (title: string) => `Technologies for ${title}`,
    liveDemo: 'View live demo',
    viewProject: 'View project',
    readCase: 'Read the case',
    allProjects: 'See all projects',
    aboutEyebrow: 'How I work',
    aboutTitle: 'Understand the system before changing it.',
    aboutLead:
      'I like turning complex context into clear technical decisions. I look at the whole flow, work close to product and leave the code ready so the next change is easier.',
    moreAboutMe: 'More about me',
    nextStep: 'Next step',
    ctaTitle: 'Shall we talk?',
    serviceName: 'Jordi Sánchez — Full-Stack Development',
    country: 'Spain',
  },
}[locale];

const experience = getExperience(locale);
// Professional cases first, the own product last.
const featuredOrder = ['pagos-3d-secure', 'integraciones-empresariales', 'plataforma-reservas', 'primer-down'];
const featuredProjects = getProjects(locale)
  .filter((project) => project.featured)
  .sort((a, b) => featuredOrder.indexOf(a.slug) - featuredOrder.indexOf(b.slug));
// The hero shows real work instead of an ornament: the payment state diagram of the 3DS case.
const heroCase = featuredProjects.find((project) => project.slug === 'pagos-3d-secure');
// Still feeds the ProfessionalService structured data; the home no longer lists services.
const services = getServices(locale);

const site = 'https://www.jordisanchezweb.es';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#jordi-sanchez`,
      name: 'Jordi Sánchez',
      url: `${site}/`,
      email: 'mailto:jordigw@gmail.com',
      jobTitle: 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Barcelona',
        addressCountry: 'ES',
      },
      sameAs: socialLinks.map((link) => link.url),
      // TODO(Jordi): añadir 'en' si quieres declarar inglés como idioma de trabajo.
      knowsLanguage: ['es', 'ca'],
      knowsAbout: [
        'React',
        'Next.js',
        'TypeScript',
        'React Native',
        'Node.js',
        t.restApis,
        'Strapi',
        'Docker',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#servicios`,
      name: t.serviceName,
      url: `${site}${path('services')}`,
      inLanguage: locale,
      founder: { '@id': `${site}/#jordi-sanchez` },
      areaServed: { '@type': 'Country', name: t.country },
      serviceType: [services[0].title, services[1].title, services[2].title, services[5].title],
    },
  ],
};
---

<BaseLayout title={t.title} description={t.description} canonicalPath={path('home')} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-heading">
        <p class="eyebrow">Full-Stack Developer</p>
        <p class="availability"><span aria-hidden="true"></span> {t.availability}</p>
      </div>

      <div class="hero-grid">
        <div class="hero-main">
          <h1 class="hero-title">{t.heroTitle}</h1>

          <div class="hero-bottom">
            <p class="hero-label" aria-hidden="true">{t.heroLabel}</p>
            <div class="hero-copy">
              <p class="lede">{t.heroLead}</p>
              <div class="hero-actions">
                <a class="button button--accent" href={path('projects')}>{t.seeCases}</a>
                <a class="text-link" href={path('contact')}>{t.contact}</a>
              </div>
            </div>
          </div>
        </div>

        {heroCase && (
          <figure class="hero-showcase">
            <a class="hero-showcase-link ink-panel" href={projectPath(heroCase.slug, locale)}>
              <CaseDiagram slug={heroCase.slug} locale={locale} caption={false} />
              <figcaption>
                <span class="hero-showcase-meta">{heroCase.area}</span>
                <span class="hero-showcase-title">{heroCase.title} <span aria-hidden="true">↗</span></span>
              </figcaption>
            </a>
          </figure>
        )}
      </div>
    </div>
  </section>

  <section class="section experience" aria-labelledby="experiencia-title">
    <div class="container">
      <SectionHeading
        id="experiencia-title"
        eyebrow={t.experienceEyebrow}
        title={t.experienceTitle}
        description={t.experienceDescription}
      />

      <ul class="exp-cells">
        {experience.map((item) => (
          <li>
            <p class="exp-period">{item.period}</p>
            <h3>{item.company}</h3>
            <p class="exp-role">{item.role}</p>
          </li>
        ))}
      </ul>

      <a class="text-link section-link" href={path('about')}>{t.fullExperience}</a>
    </div>
  </section>

  <section class="section cases" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeading
        id="projects-title"
        eyebrow={t.projectsEyebrow}
        title={t.projectsTitle}
        description={t.projectsDescription}
      />

      <ol class="case-ledger">
        {featuredProjects.map((project, index) => (
          <li>
            <p class="ledger-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3>
                <a class="project-title-link" href={projectPath(project.slug, locale)}>{project.title}</a>
              </h3>
              <p class:list={['ledger-tag', { 'ledger-tag--own': !project.anonymized }]}>{project.area}</p>
            </div>
            <p class="ledger-problem">{project.caseStudy?.problem ?? project.problem}</p>
            <span class="ledger-arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>

      <a class="text-link section-link" href={path('projects')}>{t.allProjects}</a>
    </div>
  </section>

  <section class="section about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2 id="about-title">{t.aboutTitle}</h2>
      </div>
      <div>
        <p class="lede">{t.aboutLead}</p>
        <a class="text-link" href={path('about')}>{t.moreAboutMe}</a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-grid">
      <p class="eyebrow">{t.nextStep}</p>
      <h2>{t.ctaTitle}</h2>
      <div>
        <a class="button button--accent" href={path('contact')}>{t.contact}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
  }

  .hero-inner {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .hero-heading .eyebrow {
    margin-bottom: 0;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-title {
    max-width: 17ch;
    font-size: clamp(2.5rem, 5.6vw, 5.5rem);
    line-height: 1;
  }

  .hero-showcase {
    margin: 0;
  }

  .hero-showcase-link {
    display: grid;
    gap: 0.9rem;
    text-decoration: none;
  }

  .hero-showcase :global(.case-diagram) {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
  }

  .hero-showcase-link:hover :global(.case-diagram) {
    border-color: var(--accent);
  }

  .hero-showcase figcaption {
    display: grid;
    gap: 0.3rem;
  }

  .hero-showcase-meta {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-showcase-title {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-variation-settings: 'SOFT' 0, 'WONK' 0;
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-showcase-title span {
    color: var(--accent);
  }

  .hero-showcase-link:hover .hero-showcase-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .hero-bottom {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.75rem, 4vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .hero-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-label {
    display: none;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .section-link {
    margin-top: 2rem;
  }

  .project-title-link {
    text-decoration: none;
  }

  .project-title-link:hover {
    text-decoration: underline;
    text-decoration-color: #9db8f5;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.08em;
  }

  .final-cta {
    padding-block: var(--section-space);
    background: var(--ink);
    color: #f4f5f3;
  }

  .final-cta .eyebrow {
    color: #9db8f5;
  }

  .about-grid,
  .final-cta-grid {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  .about h2,
  .final-cta h2 {
    max-width: 18ch;
  }

  .final-cta-grid > div > p {
    max-width: 34rem;
    color: #93a0ab;
  }

  .final-cta .button {
    margin-top: 1.5rem;
  }

  .about-grid > div:last-child .text-link {
    margin-top: 1.5rem;
  }

  @media (min-width: 72rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
      align-items: start;
    }

    /* The headline shares the row with the preview,
    so it stops scaling with the viewport. */
    .hero-title {
      max-width: 13ch;
      font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    }

    .hero-showcase {
      /* Line the preview up with the headline's cap height. */
      margin-top: 0.4rem;
    }
  }

  @media (min-width: 52rem) {
    .hero-label {
      display: block;
    }

    .hero-bottom {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 0.65fr);
    }

    .about-grid,
    .final-cta-grid {
      grid-template-columns: minmax(0, 1fr) minmax(23rem, 0.65fr);
      align-items: end;
    }

    .final-cta-grid .eyebrow {
      grid-column: 1 / -1;
    }
  }

  .hero-showcase-link.ink-panel:hover {
    outline: 1px solid var(--accent);
  }

  .hero-showcase .hero-showcase-meta {
    color: var(--panel-muted);
    font-family: var(--mono);
    font-weight: 500;
  }

  .hero-showcase .hero-showcase-title span {
    color: var(--panel-accent);
  }

  .hero-showcase :global(.case-diagram) {
    padding: 0;
    border: 0;
  }

  .exp-cells {
    display: grid;
    gap: 1px;
    margin: clamp(2rem, 4vw, 3rem) 0 2rem;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--line);
    list-style: none;
  }

  .exp-cells li {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper);
  }

  .exp-period,
  .ledger-index,
  .ledger-tag {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .exp-cells h3 {
    margin-top: 0.75rem;
  }

  .exp-role {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .case-ledger {
    margin: clamp(2rem, 4vw, 3rem) 0 2rem;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .case-ledger > li {
    position: relative;
    display: grid;
    gap: 0.75rem 1.5rem;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }

  .case-ledger h3 {
    font-size: clamp(1.45rem, 2.4vw, 2rem);
  }

  /* The whole row is the link target, while the heading keeps the accessible name. */
  .case-ledger .project-title-link::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .case-ledger > li:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .ledger-tag {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    font-size: 0.66rem;
  }

  .ledger-tag--own {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ledger-problem {
    max-width: 40rem;
    color: var(--muted);
  }

  .ledger-arrow {
    display: none;
    color: var(--accent);
  }

  @media (min-width: 52rem) {
    .exp-cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-ledger > li {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.4fr) 1.5rem;
      align-items: baseline;
    }

    .ledger-arrow {
      display: block;
    }
  }
</style>
