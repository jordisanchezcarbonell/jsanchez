---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperience, yearsOfExperience } from '../data/experience';
import { getEducation } from '../data/profile';
import { getLocale, localePath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const experience = getExperience(locale);
const education = getEducation(locale);
const years = yearsOfExperience();

// TODO(Jordi): confirmar ambas URL públicas (StateX aún sin dominio definitivo; Primer Down usa la demo).
const statex = '<a href="https://statex.jordisanchezweb.es/" target="_blank" rel="noreferrer">StateX</a>';
const primerDown = '<a href="https://primerdown.jordisanchezweb.es/es" target="_blank" rel="noreferrer">Primer Down</a>';

// Body paragraphs carry the two outbound links, so they are rendered as HTML. No user input reaches them.
const t = {
  es: {
    title: 'Sobre mí | Jordi Sánchez — Full-Stack Developer',
    description:
      'Experiencia, tecnologías y perfil profesional de Jordi Sánchez, Full-Stack Developer en Barcelona.',
    eyebrow: 'Sobre mí',
    heading: 'Me dedico a la parte del producto donde un fallo cuesta dinero.',
    body: [
      `Llevo ${years} años como Full-Stack Developer. Empecé en Ogilvy manteniendo plataformas internacionales y desde 2022 en Eunoia Digital construyo aplicaciones web y móviles con React, Next.js y NestJS. Con el tiempo me he ido quedando con los problemas que otros evitan: un pago 3DS que falla de forma intermitente, datos que no cuadran entre SAP y la web, un error que solo aparece en producción.`,
      `Me formé también en seguridad ofensiva (Cisco Ethical Hacker) porque quien integra pagos y sistemas de negocio tiene que saber cómo se atacan. De ahí salió ${statex}, donde audito y aseguro aplicaciones web y APIs.`,
      'Últimamente trabajo en dar a modelos de IA acceso a datos de empresa sin exponer lo que no deben ver.',
      `Fuera del trabajo construyo ${primerDown}, un archivo digital del fútbol americano en España.`,
    ],
    experienceEyebrow: 'Trayectoria',
    viewCv: 'Ver CV completo',
    educationEyebrow: 'Formación',
    educationTitle: 'Base técnica y aprendizaje continuo.',
    closing: 'Español y catalán nativos, inglés [PENDIENTE: nivel]. Barcelona, abierto a remoto.',
    seeCases: 'Ver casos',
    contact: 'Contactar',
  },
  ca: {
    title: 'Sobre mi | Jordi Sánchez — Full-Stack Developer',
    description:
      'Experiència, tecnologies i perfil professional de Jordi Sánchez, Full-Stack Developer a Barcelona.',
    eyebrow: 'Sobre mi',
    heading: 'Em dedico a la part del producte on un error costa diners.',
    body: [
      `Fa ${years} anys que treballo com a Full-Stack Developer. Vaig començar a Ogilvy mantenint plataformes internacionals i des del 2022 a Eunoia Digital construeixo aplicacions web i mòbils amb React, Next.js i NestJS. Amb el temps m’he anat quedant amb els problemes que altres eviten: un pagament 3DS que falla de manera intermitent, dades que no quadren entre SAP i el web, un error que només apareix en producció.`,
      `També em vaig formar en seguretat ofensiva (Cisco Ethical Hacker) perquè qui integra pagaments i sistemes de negoci ha de saber com s’ataquen. D’aquí va sortir ${statex}, on audito i asseguro aplicacions web i APIs.`,
      'Darrerament treballo a donar als models d’IA accés a dades d’empresa sense exposar el que no han de veure.',
      `Fora de la feina construeixo ${primerDown}, un arxiu digital del futbol americà a Espanya.`,
    ],
    experienceEyebrow: 'Trajectòria',
    viewCv: 'Veure el CV complet',
    educationEyebrow: 'Formació',
    educationTitle: 'Base tècnica i aprenentatge continu.',
    closing: 'Castellà i català nadius, anglès [PENDIENTE: nivel]. Barcelona, obert a remot.',
    seeCases: 'Veure casos',
    contact: 'Contactar',
  },
  en: {
    title: 'About | Jordi Sánchez — Full-Stack Developer',
    description:
      'Experience, technologies and professional profile of Jordi Sánchez, Full-Stack Developer in Barcelona.',
    eyebrow: 'About',
    heading: 'I work on the part of the product where a failure costs money.',
    body: [
      `I have been a Full-Stack Developer for ${years} years. I started at Ogilvy maintaining international platforms, and since 2022 at Eunoia Digital I have been building web and mobile applications with React, Next.js and NestJS. Over time I have ended up with the problems others avoid: a 3DS payment that fails intermittently, data that does not match between SAP and the website, a bug that only shows up in production.`,
      `I also trained in offensive security (Cisco Ethical Hacker), because whoever integrates payments and business systems has to know how they are attacked. That led to ${statex}, where I audit and secure web applications and APIs.`,
      'Lately I have been working on giving AI models access to company data without exposing what they should not see.',
      `Outside work I build ${primerDown}, a digital archive of American football in Spain.`,
    ],
    experienceEyebrow: 'Career',
    viewCv: 'View full CV',
    educationEyebrow: 'Education',
    educationTitle: 'Technical foundations and continuous learning.',
    closing: 'Native Spanish and Catalan, English [PENDIENTE: nivel]. Barcelona, open to remote.',
    seeCases: 'See cases',
    contact: 'Contact',
  },
}[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath={localePath('about', locale)}
>
  <header class="page-intro container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
  </header>

  <section class="profile-section" aria-label={t.eyebrow}>
    <div class="container about-layout">
      <div class="profile-copy">
        {t.body.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      <aside class="about-side" aria-labelledby="experience-title">
        <h2 id="experience-title" class="eyebrow">{t.experienceEyebrow}</h2>
        <ul class="experience-lines">
          {experience.map((item) => (
            <li>
              <span>{item.company} · {item.role}</span>
              <span class="experience-period">{item.period}</span>
            </li>
          ))}
        </ul>
        <a class="text-link" href={localePath('cv', locale)}>{t.viewCv}</a>
        <p class="closing">{t.closing.replace(/ \[PENDIENTE:[^\]]*\]/, '')}</p>
      </aside>
    </div>
  </section>

  <section class="education-section" aria-labelledby="education-title">
    <div class="container education-grid">
      <div>
        <p class="eyebrow">{t.educationEyebrow}</p>
        <h2 id="education-title">{t.educationTitle}</h2>
      </div>
      <div>
        {education.map((item) => (
          <article>
            <p>{item.meta}</p>
            <h3>{item.name}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="container">
      <div class="cta-actions">
        <a class="button button--accent" href={localePath('projects', locale)}>{t.seeCases}</a>
        <a class="text-link" href={localePath('contact', locale)}>{t.contact}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-section,
  .education-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--line);
  }

  .education-grid {
    display: grid;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .education-grid h2 {
    max-width: 11ch;
  }

  .profile-copy {
    display: grid;
    gap: 1.5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .profile-copy p {
    max-width: 42rem;
  }

  .profile-copy :global(a) {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .about-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .about-side {
    align-self: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .about-side .eyebrow {
    margin-bottom: 0;
  }

  .experience-lines {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
  }

  .experience-lines li {
    display: grid;
    gap: 0.15rem;
  }

  .experience-period {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .education-section article > p {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .education-section article {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .education-section article h3 {
    max-width: 22ch;
    margin-top: 0.65rem;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }

  .about-cta {
    padding-block: var(--section-space);
    background: #e9ecea;
  }

  .closing {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  @media (min-width: 52rem) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }

    .education-grid {
      grid-template-columns: minmax(0, 1fr) minmax(23rem, 0.72fr);
      align-items: start;
    }
  }
</style>
