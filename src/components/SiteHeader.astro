---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/proyectos/', label: 'Proyectos' },
  { href: '/servicios/', label: 'Servicios' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Jordi Sánchez, inicio">
      <span class="brand-mark" aria-hidden="true">JS</span>
      <span class="brand-name">Jordi Sánchez <small>Full-Stack</small></span>
    </a>

    <nav class="desktop-navigation" aria-label="Navegación principal">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a
        class="nav-cta"
        href="/contacto/"
        aria-current={currentPath.startsWith('/contacto') ? 'page' : undefined}
      >
        Contacto
      </a>
    </nav>

    <div class="mobile-actions">
      <a
        class="nav-cta"
        href="/contacto/"
        aria-current={currentPath.startsWith('/contacto') ? 'page' : undefined}
      >
        Contacto
      </a>
      <details class="mobile-navigation">
        <summary>Menú</summary>
        <nav aria-label="Navegación móvil">
          {links.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Hide the header while scrolling down and reveal it on scroll up.
  // It stays put for reduced-motion users, with the mobile menu open, or while it holds focus.
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = header?.querySelector<HTMLDetailsElement>('.mobile-navigation');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let lastY = window.scrollY;
  let ticking = false;

  const update = () => {
    ticking = false;
    if (!header) return;

    const y = window.scrollY;
    const delta = y - lastY;
    const pinned = reducedMotion.matches || menu?.open || header.contains(document.activeElement);

    if (pinned || y < header.offsetHeight || delta < -4) {
      header.removeAttribute('data-hidden');
    } else if (delta > 4) {
      header.setAttribute('data-hidden', '');
    }

    if (Math.abs(delta) > 4) lastY = y;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );

  header?.addEventListener('focusin', () => header.removeAttribute('data-hidden'));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    transition: transform 220ms ease;
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .header-inner {
    position: relative;
    display: flex;
    width: min(100%, var(--max-width));
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .brand-name {
    display: none;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-name small {
    display: block;
    margin-top: 0.15rem;
    color: var(--accent);
    font: inherit;
    font-size: 0.58rem;
  }

  .desktop-navigation {
    display: none;
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-cta {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--ink);
    transition: color 180ms ease, background-color 180ms ease;
  }

  .nav-cta:hover,
  .nav-cta[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  .desktop-navigation a,
  .mobile-actions .nav-cta,
  .mobile-navigation a,
  .mobile-navigation summary {
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-navigation summary {
    padding: 0.7rem 0;
    list-style: none;
    cursor: pointer;
  }

  .mobile-navigation summary::-webkit-details-marker {
    display: none;
  }

  .mobile-navigation summary::after {
    margin-left: 0.65rem;
    color: var(--accent);
    content: '+';
    font-size: 1rem;
  }

  .mobile-navigation[open] summary::after {
    content: '−';
  }

  .mobile-navigation nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    display: grid;
    padding: 1rem var(--gutter) 1.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .mobile-navigation nav a {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-navigation nav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    .brand-name {
      display: inline;
    }
  }

  @media (min-width: 68rem) {
    .mobile-actions {
      display: none;
    }

    .desktop-navigation {
      display: flex;
      align-items: center;
      gap: clamp(1rem, 2.1vw, 2rem);
    }

    .desktop-navigation a {
      position: relative;
    }

    .desktop-navigation a:not(.nav-cta)::after {
      position: absolute;
      right: 0;
      bottom: -0.45rem;
      left: 0;
      height: 1px;
      background: var(--accent);
      content: '';
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 180ms ease;
    }

    .desktop-navigation a:hover::after,
    .desktop-navigation a[aria-current='page']::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }
</style>
