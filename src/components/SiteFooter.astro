---
import { socialLinks } from '../data/social';
import { getLocale, localePath } from '../i18n';

const year = new Date().getFullYear();
const locale = getLocale(Astro.currentLocale);

interface FooterLink {
  href: string;
  label: string;
  /** Set on links to Spanish-only pages from the English site. */
  lang?: string;
}

const copy: { note: string; nav: string; profiles: string; links: FooterLink[] } = {
  es: {
    note: 'Full-Stack Developer · React, Next.js, TypeScript, APIs e integraciones.',
    nav: 'Navegación del pie',
    profiles: 'Perfiles profesionales',
    links: [
      { href: localePath('projects', 'es'), label: 'Proyectos' },
      { href: localePath('services', 'es'), label: 'Servicios' },
      { href: localePath('about', 'es'), label: 'Sobre mí' },
      { href: localePath('contact', 'es'), label: 'Contacto' },
      { href: '/clubes/', label: 'Clubes' },
      { href: '/blog/', label: 'Blog' },
      { href: '/aviso-legal/', label: 'Aviso legal' },
      { href: '/privacidad/', label: 'Privacidad' },
    ],
  },
  en: {
    note: 'Full-Stack Developer · React, Next.js, TypeScript, APIs and integrations.',
    nav: 'Footer navigation',
    profiles: 'Professional profiles',
    // Clubs and the blog target a Spanish-speaking local audience, so they are not linked here.
    links: [
      { href: localePath('projects', 'en'), label: 'Projects' },
      { href: localePath('services', 'en'), label: 'Services' },
      { href: localePath('about', 'en'), label: 'About' },
      { href: localePath('contact', 'en'), label: 'Contact' },
      { href: '/aviso-legal/', label: 'Legal notice (ES)', lang: 'es' },
      { href: '/privacidad/', label: 'Privacy (ES)', lang: 'es' },
    ],
  },
}[locale];
---

<footer class="site-footer">
  <div class="footer-main container">
    <div>
      <p class="footer-name">Jordi Sánchez</p>
      <p class="footer-note">{copy.note}</p>
    </div>

    <nav aria-label={copy.nav}>
      {copy.links.map((link) => (
        <a href={link.href} hreflang={link.lang}>{link.label}</a>
      ))}
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>© {year} Jordi Sánchez</p>
    <ul class="footer-social" aria-label={copy.profiles}>
      {socialLinks.map((link) => (
        <li><a href={link.url} target="_blank" rel="me noreferrer">{link.label}</a></li>
      ))}
      <li><a href="mailto:jordigw@gmail.com">jordigw@gmail.com</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .footer-main {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .footer-name {
    font-family: var(--sans);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .footer-note {
    max-width: 28rem;
    margin-top: 0.8rem;
    color: var(--muted);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
  }

  nav a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-bottom p {
    display: flex;
    align-items: center;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(22rem, 0.5fr);
      align-items: end;
    }
  }
</style>
