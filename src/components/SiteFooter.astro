---
import { socialLinks } from '../data/social';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-main container">
    <div>
      <p class="footer-name">Jordi Sánchez</p>
      <p class="footer-note">Full-Stack Developer · React, Next.js, TypeScript, APIs e integraciones.</p>
    </div>

    <nav aria-label="Navegación del pie">
      <a href="/proyectos/">Proyectos</a>
      <a href="/servicios/">Servicios</a>
      <a href="/sobre-mi/">Sobre mí</a>
      <a href="/contacto/">Contacto</a>
      <a href="/clubes/">Clubes</a>
      <a href="/blog/">Blog</a>
      <a href="/aviso-legal/">Aviso legal</a>
      <a href="/privacidad/">Privacidad</a>
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>© {year} Jordi Sánchez</p>
    <ul class="footer-social" aria-label="Perfiles profesionales">
      {socialLinks.map((link) => (
        <li><a href={link.url} target="_blank" rel="me noreferrer">{link.label}</a></li>
      ))}
      <li><a href="mailto:jordigw@gmail.com">jordigw@gmail.com</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .footer-main {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .footer-name {
    font-family: var(--sans);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .footer-note {
    max-width: 28rem;
    margin-top: 0.8rem;
    color: var(--muted);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
  }

  nav a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-bottom p {
    display: flex;
    align-items: center;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(22rem, 0.5fr);
      align-items: end;
    }
  }
</style>
