---
import { getLocale, localePath } from '../i18n';

const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY;
const locale = getLocale(Astro.currentLocale);
const redirectUrl = new URL(localePath('thanks', locale), 'https://www.jordisanchezweb.es');

// Field names and option values stay in Spanish so every enquiry reaches the inbox in the same shape.
const t = {
  es: {
    subject: 'Nueva consulta desde jordisanchezweb.es',
    name: 'Nombre',
    organization: 'Empresa u organización',
    optional: '(opcional)',
    reason: 'Motivo del contacto',
    choose: 'Selecciona una opción',
    reasons: ['Proyecto freelance', 'Oportunidad laboral', 'Colaboración con agencia', 'Otro'],
    message: '¿Qué necesitas?',
    messageHint: 'Contexto, alcance aproximado y cualquier fecha relevante.',
    consentBefore: 'He leído y acepto la ',
    privacy: 'política de privacidad',
    consentAfter: '.',
    submit: 'Enviar consulta',
    fallback: 'El formulario no está configurado todavía, pero puedes escribirme directamente.',
    fallbackButton: 'Escribir por email',
  },
  en: {
    subject: 'Nueva consulta desde jordisanchezweb.es (EN)',
    name: 'Name',
    organization: 'Company or organisation',
    optional: '(optional)',
    reason: 'Reason for contact',
    choose: 'Choose an option',
    reasons: ['Freelance project', 'Job opportunity', 'Agency partnership', 'Other'],
    message: 'What do you need?',
    messageHint: 'Context, rough scope and any relevant dates.',
    consentBefore: 'I have read and accept the ',
    privacy: 'privacy policy',
    consentAfter: ' (in Spanish).',
    submit: 'Send enquiry',
    fallback: 'The form is not set up yet, but you can email me directly.',
    fallbackButton: 'Send an email',
  },
}[locale];
const reasonValues = ['Proyecto freelance', 'Oportunidad laboral', 'Colaboración con agencia', 'Otro'];
---

{accessKey ? (
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    aria-labelledby="contact-form-title"
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={t.subject} />
    <input type="hidden" name="from_name" value="jordisanchezweb.es" />
    <input type="hidden" name="redirect" value={redirectUrl.href} />

    <div class="field-grid">
      <div class="field">
        <label for="nombre">{t.name}</label>
        <input id="nombre" name="nombre" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
    </div>

    <div class="field-grid">
      <div class="field">
        <label for="organizacion">{t.organization} <span>{t.optional}</span></label>
        <input id="organizacion" name="organizacion" type="text" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="tipo">{t.reason}</label>
        <select id="tipo" name="tipo" required>
          <option value="">{t.choose}</option>
          {reasonValues.map((value, index) => <option value={value}>{t.reasons[index]}</option>)}
        </select>
      </div>
    </div>

    <div class="field">
      <label for="mensaje">{t.message}</label>
      <textarea id="mensaje" name="mensaje" rows="6" required></textarea>
      <small>{t.messageHint}</small>
    </div>

    <input
      type="checkbox"
      name="botcheck"
      class="visually-hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <label class="consent" for="privacidad-contacto">
      <input id="privacidad-contacto" name="acepta_privacidad" type="checkbox" required />
      <span>{t.consentBefore}<a href="/privacidad/" hreflang="es">{t.privacy}</a>{t.consentAfter}</span>
    </label>

    <button class="submit-button" type="submit">
      {t.submit}
      <span aria-hidden="true">→</span>
    </button>
  </form>
) : (
  <div class="contact-fallback">
    <p>{t.fallback}</p>
    <a class="submit-button" href="mailto:jordigw@gmail.com">
      {t.fallbackButton}
      <span aria-hidden="true">→</span>
    </a>
  </div>
)}

<style>
  form,
  .contact-fallback {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .contact-fallback p {
    color: #aaa197;
  }

  .field-grid {
    display: grid;
    gap: 2rem;
  }

  .field {
    display: grid;
    gap: 0.55rem;
  }

  label {
    color: #f7f4ee;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  label span {
    color: #aaa197;
    font: inherit;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #6c645a;
    border-radius: 0;
    background: transparent;
    color: #fffaf3;
    outline: 0;
    transition: border-color 180ms ease;
  }

  input,
  select {
    min-height: 3rem;
  }

  select {
    appearance: none;
  }

  select option {
    color: #17130d;
  }

  textarea {
    min-height: 9rem;
    padding-block: 0.7rem;
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #c77b6d;
  }

  small {
    color: #aaa197;
    font-size: 0.76rem;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: #aaa197;
    font-size: 0.74rem;
    font-weight: 450;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
  }

  .consent input {
    width: 1rem;
    min-height: 1rem;
    margin-top: 0.2rem;
    accent-color: #aa5547;
  }

  .consent a {
    color: #f7f4ee;
  }

  .submit-button {
    display: flex;
    width: 100%;
    min-height: 4.2rem;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.3rem;
    border: 1px solid #f7f4ee;
    background: #f7f4ee;
    color: #17130d;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .submit-button span {
    color: inherit;
    font-size: 1.25rem;
    font-weight: 400;
    transition: transform 180ms ease;
  }

  .submit-button:hover {
    background: transparent;
    color: #f7f4ee;
  }

  .submit-button:hover span {
    transform: translateX(0.3rem);
  }

  @media (min-width: 38rem) {
    .field-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
