{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/clubes",
      "destination": "/negocios-locales/clubes/",
      "permanent": true
    },
    {
      "source": "/clubes/",
      "destination": "/negocios-locales/clubes/",
      "permanent": true
    },
    {
      "source": "/ejemplos",
      "destination": "/negocios-locales/ejemplos/",
      "permanent": true
    },
    {
      "source": "/ejemplos/",
      "destination": "/negocios-locales/ejemplos/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/negocios-locales/blog/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/negocios-locales/blog/",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/negocios-locales/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/:slug/",
      "destination": "/negocios-locales/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/demos",
      "destination": "/negocios-locales/demos/",
      "permanent": true
    },
    {
      "source": "/demos/",
      "destination": "/negocios-locales/demos/",
      "permanent": true
    },
    {
      "source": "/demos/:slug",
      "destination": "/negocios-locales/demos/:slug/",
      "permanent": true
    },
    {
      "source": "/demos/:slug/",
      "destination": "/negocios-locales/demos/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
